// The miniaudio object built by `make spike-build`. The compiler checks this
// path relative to this file, then passes the string to the linker from its
// working directory, so `make spike-build` builds from spike/ to satisfy both.
link static "../build/miniaudio.o"

if SALAM_OS_UNIX:
    link dynamic "m"
    link dynamic "dl"
    link dynamic "pthread"
end

extern:
    func ma_version_string(): str
end

func main:
    println ma_version_string()
    ret 0
end
