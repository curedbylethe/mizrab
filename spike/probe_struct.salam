// STAGE-02 Task B: a throwaway probe, never built by `make spike-build`.
// It asks whether `ma_device_config` can be mirrored in Salam and returned by
// value from an `extern`, so STAGE-04 can quote the answer. A compile failure
// here is the finding, not a thing to route around.

extern:
    func ma_device_config_init(kind: int): MaDeviceConfig
    func ma_device_init(ctx: void *, cfg: MaDeviceConfig *, dev: void *): int
end

// Field order and types copied from audio/miniaudio.h 0.11.25. Enums are C
// `int`, ma_bool8 is one byte, ma_bool32 is four, and function pointers keep
// pointer size, so `void *` stands in for them here.
struct MaResamplerConfig:
    pub format: int
    pub channels: u32
    pub sampleRateIn: u32
    pub sampleRateOut: u32
    pub algorithm: int
    pub pBackendVTable: void *
    pub pBackendUserData: void *
    pub linear_lpfOrder: u32
end

struct MaDeviceSubConfig:
    pub pDeviceID: void *
    pub format: int
    pub channels: u32
    pub pChannelMap: void *
    pub channelMixMode: int
    pub calculateLFEFromSpatialChannels: int
    pub shareMode: int
end

struct MaDeviceWasapiConfig:
    pub usage: int
    pub noAutoConvertSRC: u8
    pub noDefaultQualitySRC: u8
    pub noAutoStreamRouting: u8
    pub noHardwareOffloading: u8
    pub loopbackProcessID: u32
    pub loopbackProcessExclude: u8
end

struct MaDeviceAlsaConfig:
    pub noMMap: int
    pub noAutoFormat: int
    pub noAutoChannels: int
    pub noAutoResample: int
end

struct MaDevicePulseConfig:
    pub pStreamNamePlayback: void *
    pub pStreamNameCapture: void *
    pub channelMap: int
end

struct MaDeviceCoreAudioConfig:
    pub allowNominalSampleRateChange: int
end

struct MaDeviceOpenslConfig:
    pub streamType: int
    pub recordingPreset: int
    pub enableCompatibilityWorkarounds: int
end

struct MaDeviceAaudioConfig:
    pub usage: int
    pub contentType: int
    pub inputPreset: int
    pub allowedCapturePolicy: int
    pub noAutoStartAfterReroute: int
    pub enableCompatibilityWorkarounds: int
    pub allowSetBufferCapacity: int
end

struct MaDeviceConfig:
    pub deviceType: int
    pub sampleRate: u32
    pub periodSizeInFrames: u32
    pub periodSizeInMilliseconds: u32
    pub periods: u32
    pub performanceProfile: int
    pub noPreSilencedOutputBuffer: u8
    pub noClip: u8
    pub noDisableDenormals: u8
    pub noFixedSizedCallback: u8
    pub dataCallback: void *
    pub notificationCallback: void *
    pub stopCallback: void *
    pub pUserData: void *
    pub resampling: MaResamplerConfig
    pub playback: MaDeviceSubConfig
    pub capture: MaDeviceSubConfig
    pub wasapi: MaDeviceWasapiConfig
    pub alsa: MaDeviceAlsaConfig
    pub pulse: MaDevicePulseConfig
    pub coreaudio: MaDeviceCoreAudioConfig
    pub opensl: MaDeviceOpenslConfig
    pub aaudio: MaDeviceAaudioConfig
end

func main:
    // (a) type-checks: did this file build at all?
    mut cfg := ma_device_config_init(1)

    // (b) fields read back after a round trip through C.
    cfg.playback.format = 5
    cfg.playback.channels = 2
    cfg.sampleRate = 48000 as u32
    println "format=" + (cfg.playback.format as u64)
    println "channels=" + (cfg.playback.channels as u64)
    println "sampleRate=" + (cfg.sampleRate as u64)
    println "noPreSilenced=" + (cfg.noPreSilencedOutputBuffer as u64)

    // (c) hand the same struct back to C by pointer.
    // Measured with Salam 0.5.6: error[E023]: cannot cast 'MaDeviceConfig' to
    // 'MaDeviceConfig*' (completed with EXIT 1). `&cfg` is no better: E072,
    // "'&cfg' requires a function".
    ctx := 0 as u64
    dev := 0 as u64
    result := ma_device_init(ctx as void *, cfg as MaDeviceConfig *, dev as void *)
    println "ma_device_init=" + (result as u64)

    ret 0
end
