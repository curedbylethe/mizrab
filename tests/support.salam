package support

import mem
import sync
import "github.com/curedbylethe/basalam/basalam"

include "../audio/audio.salam"

@en "FakeClock"
/// A test-owned clock for calls to `player.Tick`.
pub struct FakeClock:
    pub now: i64 = 0
end

@en "PumpFrames"
/// Drives the audio engine by requesting frames without starting its callback.
pub func PumpFrames(frames: int):
    buf := mem.AllocateZeroed((frames * 2 * 4) as u64) as f32*
    audio.FillFrames(buf, frames as i64)
    mem.Free(buf as void*)
end

@en "PumpUntil"
/// Pumps up to `maxFrames` until `done` reports that playback has settled.
pub func PumpUntil(maxFrames: int, done: func () bool):
    buf := mem.AllocateZeroed((512 * 2 * 4) as u64) as f32*
    mut pumped := 0
    mut status := audio.ReadStatus()
    until done() == false and pumped < maxFrames:
        if status.fillLevel == 0 and status.atEnd == false:
            sync.SleepMs(1)
        end
        mut frames := 512
        if maxFrames - pumped < frames:
            frames = maxFrames - pumped
        end
        audio.FillFrames(buf, frames as i64)
        pumped = pumped + frames
        status = audio.ReadStatus()
    end
    mem.Free(buf as void*)
end

@en "FrameText"
/// Draws a headless screen and returns its rows as newline-separated text.
pub func FrameText(screen: basalam.Screen): str:
    screen.present()
    mut text := ""
    mut y := 0
    until y < screen.buffer.height:
        if y > 0:
            text = text + "\n"
        end
        text = text + screen.buffer.row_text(y)
        y = y + 1
    end
    ret text
end
