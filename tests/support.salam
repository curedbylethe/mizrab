package support

import mem
import sync
import "github.com/curedbylethe/basalam/basalam"

include "../audio/audio.salam"

@en "FakeClock"
/// A test-owned clock for calls to `player.Tick`.
pub struct FakeClock:
    pub now: i64 = 0
end

@en "PumpFrames"
/// Drives the audio engine by requesting frames without starting its callback.
pub func PumpFrames(frames: int):
    buf := mem.AllocateZeroed((frames * 2 * 4) as u64) as f32*
    audio.FillFrames(buf, frames as i64)
    mem.Free(buf as void*)
end

@en "PumpUntilEnd"
/// Pumps up to `maxFrames` while the decoder reaches end and the ring drains.
pub func PumpUntilEnd(maxFrames: int):
    buf := mem.AllocateZeroed((512 * 2 * 4) as u64) as f32*
    mut pumped := 0
    mut status := audio.ReadStatus()
    until (status.atEnd == false or status.fillLevel > 0) and pumped < maxFrames:
        if status.fillLevel == 0 and status.atEnd == false:
            sync.SleepMs(1)
        end
        mut frames := 512
        if maxFrames - pumped < frames:
            frames = maxFrames - pumped
        end
        audio.FillFrames(buf, frames as i64)
        pumped = pumped + frames
        status = audio.ReadStatus()
    end
    mem.Free(buf as void*)
end

@en "PumpUntilSeek"
/// Pumps until the decoder completes a queued seek or the frame budget ends.
pub func PumpUntilSeek(maxFrames: int):
    buf := mem.AllocateZeroed((512 * 2 * 4) as u64) as f32*
    mut pumped := 0
    mut status := audio.ReadStatus()
    until audio.DecoderSeekPending() and pumped < maxFrames:
        if status.fillLevel == 0 and status.atEnd == false:
            sync.SleepMs(1)
        end
        mut frames := 512
        if maxFrames - pumped < frames:
            frames = maxFrames - pumped
        end
        audio.FillFrames(buf, frames as i64)
        pumped = pumped + frames
        status = audio.ReadStatus()
    end
    mem.Free(buf as void*)
end

@en "Now"
/// Reads a fake clock without advancing it.
pub func Now(clock: FakeClock): i64:
    ret clock.now
end

@en "Advance"
/// Advances a fake clock by `ms` and returns its new value.
pub func Advance(clock &: FakeClock, ms: i64): i64:
    clock.now = clock.now + ms
    ret clock.now
end

@en "FrameText"
/// Draws a headless screen and returns its rows as newline-separated text.
pub func FrameText(screen: basalam.Screen): str:
    screen.present()
    mut text := ""
    mut y := 0
    until y < screen.buffer.height:
        if y > 0:
            text = text + "\n"
        end
        text = text + screen.buffer.row_text(y)
        y = y + 1
    end
    ret text
end
