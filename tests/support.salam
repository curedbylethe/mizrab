package support

import "github.com/curedbylethe/basalam/basalam"

@en "FrameText"
/// Draws a headless screen and returns its rows as newline-separated text.
pub func FrameText(screen: basalam.Screen): str:
    screen.present()
    mut text := ""
    mut y := 0
    until y < screen.buffer.height:
        if y > 0:
            text = text + "\n"
        end
        text = text + screen.buffer.row_text(y)
        y = y + 1
    end
    ret text
end
