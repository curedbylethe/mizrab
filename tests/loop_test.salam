// Drives ui.Run headless: events are posted before the run, so the loop is
// deterministic and terminates on `q`. start() is never called, so present()
// never flushes and the golden stays byte-exact. The flag path is "" so the
// loop writes no state file in the test tree. The handler is a recorder
// instead of the player, which is why the loop takes a callback.

import term
import testing
import "github.com/curedbylethe/basalam/basalam"

include "../ui/ui.salam"

// The verbs the loop applied and the ticks it delivered. Package globals
// because a lambda captures by value: a captured local Vector would be a copy
// and would stay empty, as tests/keymap_test.salam records.
mut applied := Vector {} as Vector<ui.Command>

mut ticks := 0

// Full-frame paints seen by a widget the test registers. A present() with
// nothing pending returns before drawing, so this counts the frames the loop
// forced, not the loop's iterations.
mut paints := 0

// A widget that only counts the frames it is painted in.
struct Counter:
    pub use basalam.BaseWidget

    pub func render(buf: basalam.Buffer, bounds: basalam.Rect):
        _ := buf
        _ := bounds
        paints = paints + 1
    end
end

// The recorder the loop reports to: the player's place in production.
func record(command: ui.Command):
    applied.push(command)
end

// One decoded key press, the shape the input thread posts.
func key(seq: str): basalam.Event:
    ret basalam.Event { kind = basalam.KeyEvent, key = term.Decode(seq) }
end

// The four keys arrive in order, and the loop reports the three verbs the
// keymap owns; `q` stops the loop instead of reporting anything.
func test_keys_become_commands():
    mut shell := ui.NewShell(80, 24)
    defer shell.Close()
    applied.clear()
    _ := shell.screen.post(key(" "))
    _ := shell.screen.post(key("n"))
    _ := shell.screen.post(key("p"))
    _ := shell.screen.post(key("q"))

    ui.Run("", shell, (command: ui.Command): record(command) end, (): end)
    testing.AssertEqInt(applied.len(), 3)
    testing.AssertTrue(applied.get(0) == ui.Command.PlayPause)
    testing.AssertTrue(applied.get(1) == ui.Command.Next)
    testing.AssertTrue(applied.get(2) == ui.Command.Prev)
    // Run closes the screen on the way out, so a Shell is single-use: the
    // second call this test used to make would read a freed event channel.
    testing.AssertFalse(shell.screen.running)
end

// A tick calls onTick and reports no command; the loop keeps going until `q`.
func test_tick_is_not_a_command():
    mut shell := ui.NewShell(80, 24)
    defer shell.Close()
    applied.clear()
    ticks = 0
    _ := shell.screen.post(basalam.Event { kind = basalam.TickEvent })
    _ := shell.screen.post(key("q"))

    ui.Run("", shell, (command: ui.Command): record(command) end, (): ticks = ticks + 1 end)
    testing.AssertEqInt(shell.screen.tick_ms, ui.TickMs)
    testing.AssertEqInt(ticks, 1)
    testing.AssertEqInt(applied.len(), 0)
end

// `q` as the very first event stops the screen before any verb is applied.
func test_quit_first_returns_immediately():
    mut shell := ui.NewShell(80, 24)
    defer shell.Close()
    applied.clear()
    _ := shell.screen.post(key("q"))

    ui.Run("", shell, (command: ui.Command): record(command) end, (): end)
    testing.AssertEqInt(applied.len(), 0)
end

// A resize reaches the shell and not only the screen: the degrade cover takes
// the new bounds and Degraded() reports the shrink, which dispatch alone misses.
func test_resize_reaches_the_shell():
    mut shell := ui.NewShell(80, 24)
    defer shell.Close()
    _ := shell.screen.post(
        basalam.Event { kind = basalam.ResizeEvent, width = 39, height = 12 }
    )
    _ := shell.screen.post(key("q"))

    ui.Run("", shell, (command: ui.Command): record(command) end, (): end)
    testing.AssertTrue(shell.Degraded())
end

// A key whose command changes the view must repaint even when the event itself
// touched nothing on screen: the mouse event is unconsumed and dirties no
// widget, so the extra frame is the ViewChanged drain's.
func test_view_change_repaints():
    mut shell := ui.NewShell(80, 24)
    defer shell.Close()
    counter := Counter {} as dyn basalam.Widget
    _ := shell.screen.add(basalam.RootId, counter)
    counter.set_bounds(basalam.Rect { width = 1, height = 1 })

    _ := shell.screen.post(key(" "))
    _ := shell.screen.post(basalam.Event { kind = basalam.MouseEvent })
    _ := shell.screen.post(key("q"))
    paints = 0

    ui.Run("", shell, (command: ui.Command): ui.LibraryMove(1) end, (): end)
    testing.AssertEqInt(applied.len(), 0)
    testing.AssertTrue(paints >= 4)
    testing.AssertFalse(ui.ViewChanged())
end

func main(): int:
    test_keys_become_commands()
    test_tick_is_not_a_command()
    test_quit_first_returns_immediately()
    test_resize_reaches_the_shell()
    test_view_change_repaints()
    ret testing.Summary()
end
