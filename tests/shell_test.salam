// Drives ui.Shell headless: the root bounds, the hand-computed refit rects at
// 40 × 12, the four stops in ring order, the two header texts that are never
// stops, the hint ladder and the degrade threshold. start() is never called,
// so the golden stays byte-exact.
//
// Widget ids follow from the Screen.add order: 0 root, 1 header, 2 wordmark,
// 3 context, 4 body Stack, 5 body Panel, 6 footer, 7 status, 8 keys, 9 mode.

import testing
import "github.com/curedbylethe/basalam/basalam"

include "../ui/ui.salam"

func assert_rect(got: basalam.Rect, x: int, y: int, w: int, h: int):
    testing.AssertEqInt(got.x, x)
    testing.AssertEqInt(got.y, y)
    testing.AssertEqInt(got.width, w)
    testing.AssertEqInt(got.height, h)
end

// At 80 × 24 the root fills the screen and the body panel is stop 1.
func test_construction():
    mut shell := ui.NewShell(80, 24)
    defer shell.Close()
    assert_rect(shell.screen.root.bounds(), 0, 0, 80, 24)
    testing.AssertEqInt(shell.screen.focused_id(), 5)
end

// The refit at 40 × 12. Every rect below is hand-written: header h 1, body
// h 10, footer h 1; header pad-x 2 gap 2 leaves the context 19 cells; footer
// pad-x 1 gap 1 leaves the keys 16 cells.
func test_refit_at_40x12():
    mut shell := ui.NewShell(80, 24)
    defer shell.Close()
    shell.Resize(40, 12)

    assert_rect(shell.screen.root.bounds(), 0, 0, 40, 12)
    assert_rect(shell.screen.widget(1).bounds(), 0, 0, 40, 1)
    assert_rect(shell.screen.widget(2).bounds(), 2, 0, 15, 1)
    assert_rect(shell.screen.widget(3).bounds(), 19, 0, 19, 1)
    assert_rect(shell.screen.widget(4).bounds(), 0, 1, 40, 10)
    assert_rect(shell.screen.widget(5).bounds(), 0, 1, 40, 10)
    assert_rect(shell.screen.widget(6).bounds(), 0, 11, 40, 1)
    assert_rect(shell.screen.widget(7).bounds(), 1, 11, 11, 1)
    assert_rect(shell.screen.widget(8).bounds(), 13, 11, 16, 1)
    assert_rect(shell.screen.widget(9).bounds(), 30, 11, 9, 1)
end

// The ring is registry order: body → status → keys → mode → body, and a fifth
// step repeats the second stop.
func test_focus_ring():
    mut shell := ui.NewShell(80, 24)
    defer shell.Close()
    ids := shell.FocusOrder()
    defer ids.free()
    testing.AssertEqInt(ids.len(), 4)
    testing.AssertEqInt(ids.get(0), 5)
    testing.AssertEqInt(ids.get(1), 7)
    testing.AssertEqInt(ids.get(2), 8)
    testing.AssertEqInt(ids.get(3), 9)

    testing.AssertEqInt(shell.screen.focused_id(), 5)
    testing.AssertTrue(shell.screen.focus_next())
    testing.AssertEqInt(shell.screen.focused_id(), 7)
    testing.AssertTrue(shell.screen.focus_next())
    testing.AssertEqInt(shell.screen.focused_id(), 8)
    testing.AssertTrue(shell.screen.focus_next())
    testing.AssertEqInt(shell.screen.focused_id(), 9)
    testing.AssertTrue(shell.screen.focus_next())
    testing.AssertEqInt(shell.screen.focused_id(), 5)
    testing.AssertTrue(shell.screen.focus_next())
    testing.AssertEqInt(shell.screen.focused_id(), 7)
end

// The wordmark and the context are never focus stops.
func test_header_is_not_a_stop():
    mut shell := ui.NewShell(80, 24)
    defer shell.Close()
    testing.AssertFalse(shell.screen.can_focus(2))
    testing.AssertFalse(shell.screen.can_focus(3))
    testing.AssertTrue(shell.screen.can_focus(5))
    testing.AssertTrue(shell.screen.can_focus(7))
    testing.AssertTrue(shell.screen.can_focus(8))
    testing.AssertTrue(shell.screen.can_focus(9))
end

// Full labels at 100, short labels at 80, and at 65 the p and / hints are
// already dropped while space and q stay.
func test_hint_ladder():
    mut shell := ui.NewShell(100, 30)
    defer shell.Close()
    testing.AssertEqStr(shell.Hints(100), "space play/pause  n next  p previous  : command  / search  q quit")
    testing.AssertEqStr(shell.Hints(80), "space play  n next  p prev  : cmd  / search  q quit")
    testing.AssertEqStr(shell.Hints(65), "space play  n next  : cmd  q quit")
end

// The degrade line takes over below 60 columns or 12 rows; 60 × 12 itself is
// still the drawn layout.
func test_degrade_threshold():
    mut shell := ui.NewShell(80, 24)
    defer shell.Close()
    testing.AssertFalse(shell.Degraded())
    shell.Resize(60, 12)
    testing.AssertFalse(shell.Degraded())
    shell.Resize(59, 12)
    testing.AssertTrue(shell.Degraded())
    shell.Resize(60, 11)
    testing.AssertTrue(shell.Degraded())
end

func main(): int:
    test_construction()
    test_refit_at_40x12()
    test_focus_ring()
    test_header_is_not_a_stop()
    test_hint_ladder()
    test_degrade_threshold()
    ret testing.Summary()
end
