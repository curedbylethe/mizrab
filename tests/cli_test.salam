// Pins the strings the CLI answers with. The rendered output of --version and
// --help is checked by the smoke checks in run.sh, against the real binary.

import testing

include "../commands/commands.salam"

func main:
    testing.AssertEqStr(commands.Version, "0.0.1")
    testing.AssertContains(commands.Usage(), "terminal music player")
    ret testing.Summary()
end
