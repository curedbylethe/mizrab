// Covers the path rule in config.Resolve with literal arguments, so no real
// environment is needed: four absolute XDG values win, empty ones fall back
// under HOME, a relative one is ignored, a trailing slash is cleaned, and no
// HOME at all yields "". Then the two file helpers, and FromEnv against the
// same five reads done by the test, which proves the wiring without depending
// on the developer's own values.

import os
import testing

include "../config/config.salam"

func absoluteTests:
    p := config.Resolve("/home/u", "/x/cfg", "/x/data", "/x/cache", "/x/state")
    testing.AssertEqStr(p.config, "/x/cfg/mizrab")
    testing.AssertEqStr(p.data, "/x/data/mizrab")
    testing.AssertEqStr(p.cache, "/x/cache/mizrab")
    testing.AssertEqStr(p.state, "/x/state/mizrab")
end

func fallbackTests:
    p := config.Resolve("/home/u", "", "", "", "")
    testing.AssertEqStr(p.config, "/home/u/.config/mizrab")
    testing.AssertEqStr(p.data, "/home/u/.local/share/mizrab")
    testing.AssertEqStr(p.cache, "/home/u/.cache/mizrab")
    testing.AssertEqStr(p.state, "/home/u/.local/state/mizrab")
end

// A relative variable is not absolute and so unused, per the XDG spec.
func relativeTests:
    p := config.Resolve("/home/u", "rel", "", "", "")
    testing.AssertEqStr(p.config, "/home/u/.config/mizrab")
end

func trailingSlashTests:
    p := config.Resolve("/home/u", "/x/cfg/", "/x/data/", "/x/cache/", "/x/state/")
    testing.AssertEqStr(p.config, "/x/cfg/mizrab")
    testing.AssertEqStr(p.data, "/x/data/mizrab")
    testing.AssertEqStr(p.cache, "/x/cache/mizrab")
    testing.AssertEqStr(p.state, "/x/state/mizrab")
end

// Four ""; never a relative path.
func unresolvedTests:
    p := config.Resolve("", "", "", "", "")
    testing.AssertEqStr(p.config, "")
    testing.AssertEqStr(p.data, "")
    testing.AssertEqStr(p.cache, "")
    testing.AssertEqStr(p.state, "")
end

func fileTests:
    p := config.Resolve("/home/u", "", "", "", "")
    testing.AssertEqStr(config.ConfigFile(p), "/home/u/.config/mizrab/config.ini")
    testing.AssertEqStr(config.IndexFile(p), "/home/u/.local/share/mizrab/index.json")
    empty := config.Resolve("", "", "", "", "")
    testing.AssertEqStr(config.ConfigFile(empty), "")
    testing.AssertEqStr(config.IndexFile(empty), "")
end

func envTests:
    got := config.FromEnv()
    want := config.Resolve(
        os.Env("HOME"), os.Env("XDG_CONFIG_HOME"), os.Env("XDG_DATA_HOME"), os.Env("XDG_CACHE_HOME"),
        os.Env("XDG_STATE_HOME"),
    )
    testing.AssertEqStr(got.config, want.config)
    testing.AssertEqStr(got.data, want.data)
    testing.AssertEqStr(got.cache, want.cache)
    testing.AssertEqStr(got.state, want.state)
end

func main:
    absoluteTests()
    fallbackTests()
    relativeTests()
    trailingSlashTests()
    unresolvedTests()
    fileTests()
    envTests()
    ret testing.Summary()
end
