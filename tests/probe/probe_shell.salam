// The startup/shutdown instrument, driven by tests/shell-measure.sh.
// Not a test: the name has no _test suffix, so tests/run.sh never discovers it,
// and the numbers depend on the machine, so nothing asserts them.
//
// It measures what a user waits through on a real terminal, so it must run
// under a pty: ui.Open is a no-op when stdin is not a terminal, and without it
// neither raw mode, the alternate screen, the input thread nor the join in
// Screen.close() would be in the figure. The probe refuses a non-tty rather
// than reporting the headless numbers.
//
// Startup is timed from just before ui.Begin() to after the first present():
// the guard install and flag file, NewTerminalShell (term.Size + NewShell),
// Open (MakeRaw, alternate screen, hidden cursor, input thread spawn) and the
// first painted frame. config.FromEnv and the instance lock run before the
// timer, in main's order, so their cost is not folded into startup; the lock is
// released immediately, while a real run holds it for the session.
//
// Shutdown is timed from after that first present() through shell.Close() and
// ui.End(): Screen.close() restores the terminal, joins the input thread (which
// polls every 20 ms, so this is the real bounded wait) and frees.
//
// Writes exactly `startup_us=N shutdown_us=M` to argv[1], not stdout: the
// screen is attached, so stdout carries escape sequences.

import conv
import filepath
import io
import os
import term
import time

include "../../config/config.salam"
include "../../ui/ui.salam"

func main():
    args := os.Args()
    if args.len() < 2:
        io.EPrintln("probe_shell: usage: probe_shell <result-file>")
        ret 2
    end
    if not ui.IsTTY():
        io.EPrintln("probe_shell: stdin is not a terminal; run it under a pty (tests/shell-measure.sh)")
        ret 2
    end
    size := term.Size()
    if size.cols <= 0 or size.rows <= 0:
        io.EPrintln("probe_shell: the pty reported no window size; run it from a sized terminal")
        ret 2
    end
    out := args[1]
    paths := config.FromEnv()
    if paths.state == "":
        io.EPrintln("probe_shell: cannot resolve a state directory; set XDG_STATE_HOME to a temp dir")
        ret 2
    end
    // Under build/tests/probe via XDG_STATE_HOME, never the developer's state.
    flagPath := filepath.Join(paths.state, "shell.flag")
    lock := ui.Acquire(ui.LockPath(paths))
    ui.Release(lock)
    t0 := time.MonoNanos()
    ui.Begin(flagPath)
    shell := ui.NewTerminalShell()
    shell.screen.tick_ms = ui.TickMs
    ui.Open(shell)
    shell.screen.present()
    t1 := time.MonoNanos()
    shell.Close()
    ui.End(flagPath)
    t2 := time.MonoNanos()
    _ := os.WriteFile(
        out, "startup_us=" + conv.FormatInt((t1 - t0) / 1000) + " shutdown_us=" + conv.FormatInt((t2 - t1) / 1000),
    )
    ret 0
end
