// The play/stop churn driver, used by tests/leaks.sh. Not a test: the name has
// no _test suffix, so tests/run.sh never discovers it.
//
// Arguments: CYCLES (a non-negative integer, 0 allowed) and an optional
// `screen`. It plays and stops fixtures/tone.wav CYCLES times on miniaudio's
// null backend, so every cycle opens a file, spawns the decoder thread,
// creates the device and tears both down again. With `screen` it also builds
// the real shell (config.FromEnv, NewTerminalShell, Open, present) and keeps it
// open while it holds still, which starts the screen's own input and winch
// threads; the sampler counts whichever of them are alive, so tests/leaks.sh
// prints the measured difference instead of assuming two. That mode needs a
// terminal, so tests/leaks.sh runs it under a pty. Without it the process
// never touches the terminal and starts no shell threads.
//
// Then it prints its pid and holds still for twenty seconds, which is long
// enough for an outside sampler to count file descriptors and threads at two
// points and see whether the churn or the shell left anything behind. Two
// points are not proof of absence, and a clean 3 s -> 8 s delta only says the
// counts did not grow inside those five seconds. Exit 1 on the first cycle
// that fails to start, 2 on a bad argument. The shell, when asked for, is
// closed on the way out.

import conv
import os
import sync
import term

link static "../../build/miniaudio.o"
link static "../../build/ma_shim.o"

if SALAM_OS_UNIX:
    link dynamic "m"
    link dynamic "dl"
    link dynamic "pthread"
end

include "../../config/config.salam"
include "../../player/player.salam"
include "../../ui/ui.salam"

// The fixture tests/player_test.salam already plays; no new fixture.
const _FIXTURE := "fixtures/tone.wav"

// The idle window the sampler needs: 3 s and 8 s samples plus the margin that
// keeps the process alive after the second one.
const _IDLE_MS := 20000

// The pid line the sampler reads, and the hold it samples during. The flush
// matters: stdout to a file is block-buffered, so without it the line only
// reaches the sampler when the process exits, which is after every sample.
func _hold():
    println "pid=" + conv.FormatInt(os.Pid() as i64)
    term.Flush()
    sync.SleepMs(_IDLE_MS)
end

func main():
    args := os.Args()
    if args.len() < 2 or args.len() > 3:
        println "probe_audio: usage: probe_audio CYCLES [screen]"
        ret 2
    end
    cycles := conv.Atoi(args.get(1))
    // Atoi is lenient: round-tripping rejects "", "x", "1x" and "007", and the
    // sign check rejects a negative cycle count.
    if cycles < 0 or conv.FormatInt(cycles as i64) != args.get(1):
        println "probe_audio: CYCLES must be a non-negative integer: " + args.get(1)
        ret 2
    end
    mut with_screen := false
    if args.len() == 3:
        if args.get(2) != "screen":
            println "probe_audio: unknown mode: " + args.get(2)
            ret 2
        end
        with_screen = true
    end

    player.Init(true)
    mut i := 0
    // `until C` loops while C holds, so this runs exactly `cycles` times.
    until i < cycles:
        if not player.Play(_FIXTURE):
            println "probe_audio: play failed: " + player.LastErrorText() + ": " + player.LastErrorDetail()
            ret 1
        end
        _ := player.Stop()
        i += 1
    end

    if with_screen:
        _ := config.FromEnv()
        mut shell := ui.NewTerminalShell()
        ui.Open(shell)
        shell.screen.present()
        _hold()
        shell.Close()
    else:
        _hold()
    end
    ret 0
end
