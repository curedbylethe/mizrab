import conv
import filepath
import flag
import io
import os
import term
import time

include "commands/commands.salam"
include "config/config.salam"
include "library/library.salam"
// ui before player: the LLVM backend resolves an enum member written in the
// entry file against the first type of that name in the module, and both
// packages declare a Command. Reordering makes ui.Command unnameable here.
include "ui/ui.salam"
include "player/player.salam"

link static "build/miniaudio.o"
link static "build/ma_shim.o"
link static "build/library_shim.o"

func main:
    f := flag.New("mizrab", commands.Usage())
    defer flag.Free(f)
    flag.AddBool(f, "version", "v", false, "print the version and exit")
    flag.AddBool(f, "scan", "", false, "scan the library roots given as arguments and write the index")
    flag.AddStr(f, "index", "", "", "index file to read and write (default: <data>/mizrab/index.json)")
    flag.AddStr(f, "config", "", "", "config file to read (default: <config>/mizrab/config.ini)")
    if not flag.Parse(f, os.Args()):
        println "mizrab:", flag.Error(f)
        ret 2
    end
    if flag.HelpWanted(f):
        print flag.Usage(f)
        ret 0
    end
    if flag.GetBool(f, "version"):
        println "mizrab " + commands.Version
        ret 0
    end
    // The file is read after --help and --version, so a broken config cannot
    // make either of them fail. A missing default file is not an error; a
    // missing --config is, because the caller named it.
    paths := config.FromEnv()
    mut cfgPath := flag.GetStr(f, "config")
    explicit := flag.WasSet(f, "config")
    if cfgPath == "":
        cfgPath = config.ConfigFile(paths)
    end
    mut file := config.Settings {}
    if cfgPath != "":
        if os.Exists(cfgPath):
            mut e := config.LoadError {}
            file = config.LoadFile(cfgPath, e)
            if e.text != "":
                println "mizrab: " + config.Describe(cfgPath, e)
                ret 2
            end
        else explicit:
            println "mizrab: cannot read " + cfgPath
            ret 2
        end
    end
    if flag.GetBool(f, "scan"):
        // Parse was handed os.Args(), so the program name is positional 0;
        // skip it only when it is there, so a caller passing a bare argument
        // list does not lose the first root.
        args := flag.Positional(f)
        mut cli := config.Settings {}
        mut first := 0
        if args.len() > 0 and args[0] == os.Args()[0]:
            first = 1
        end
        repeat args.len() - first in i:
            cli.roots.push(args[i + first])
        end
        cli.indexPath = flag.GetStr(f, "index")
        // Positional roots sit at the CLI level, so they beat the file's roots,
        // and --index beats the file's library.index.
        st := config.Resolve(config.Defaults(), file, cli)
        if st.roots.len() == 0:
            println "mizrab: --scan needs at least one root"
            ret 2
        end
        mut indexPath := st.indexPath
        if indexPath == "":
            indexPath = config.IndexFile(paths)
            if indexPath == "":
                println "mizrab: cannot find a data directory; pass --index"
                ret 2
            end
        end
        mut count := library.ScanCount {}
        if library.Scan(st.roots, indexPath, count) != 0:
            println "mizrab: scan failed: " + indexPath
            ret 1
        end
        println "mizrab: scanned " + conv.FormatInt(count.total as i64) + " tracks: " + conv.FormatInt(count.added as i64) + " added, " + conv.FormatInt(count.updated as i64) + " updated, " + conv.FormatInt(count.removed as i64) + " removed"
        ret 0
    end
    // A terminal gets the player; anything else gets the usage block, which is
    // what every non-interactive caller (CI, a pipe) has always seen.
    if term.IsTTY(term.StdinFd):
        ret runShell()
    end
    print flag.Usage(f)
    ret 0
end

// The UI path: take the single-instance lock, then build the one Shell and run
// the loop until it stops; the loop owns Begin, Close and End, so the terminal
// teardown and the crash flag are in one place. The lock is taken before the
// screen is opened and released by defer, so a second launch never installs a
// handler or touches the terminal. A state directory that cannot be resolved
// turns the lock and the flag off rather than stopping the player: a missing
// XDG directory must not be the reason someone cannot play music.
func runShell(): int:
    player.Init(false)
    shell := ui.NewTerminalShell()
    paths := config.FromEnv()
    mut flagPath := ""
    if paths.state == "":
        io.EPrint("mizrab: cannot resolve a state directory; running without the instance lock or the terminal restore flag\n")
    else:
        flagPath = filepath.Join(paths.state, "shell.flag")
    end
    // Acquired before ui.Run opens the screen, so a second launch never
    // installs a handler or touches the terminal. The defer is at function
    // scope on purpose: inside a block it would run when the block ends, and
    // the lock would be free for the whole session.
    lock := ui.Acquire(ui.LockPath(paths))
    if lock.path != "" and not lock.held:
        io.EPrint(ui.BusyMessage(lock.path, lock.pid) + "\n")
        ret 1
    end
    defer ui.Release(lock)
    _ := ui.LibraryLoad(config.IndexFile(paths))
    SyncQueue()
    pushPlayback()
    // The parsed commands are executed on the loop thread, where the player's
    // unsynchronised state already lives. Installed before Run so the first
    // `:play` can never arrive without a sink.
    ui.SetVerbSink((verb: ui.Verb): runVerb(verb) end)
    ui.Run(
        flagPath, shell, (command: ui.Command): onCommand(command) end, (): player.Tick(time.MonoMillis()) ui.SetPlaying(player.CurrentPath()) pushPlayback() end,
    )
    ret 0
end

// The one place the player's state becomes the interface's playback state: the
// word and glyph the footer shows and the clock the panel shows, read once per
// tick and once before the first frame so nothing opens on a stale word.
func pushPlayback():
    state := player.CurrentState()
    mut word := "stopped"
    mut glyph := "■"
    if state == player.State.Playing:
        word = "playing"
        glyph = "▶︎"
    else state == player.State.Paused:
        word = "paused"
        glyph = "‖"
    end
    ui.SetPlayback(word, glyph, player.PositionMs(), player.DurationMs())
end

// The queue is the visible order: a search that narrows the view must not let
// n/p jump to a hidden track. Called on load and, from stage 05, when a search
// is accepted.
func SyncQueue():
    player.QueueClear()
    paths := ui.LibraryVisiblePaths()
    defer paths.free()
    mut i := 0
    until i < paths.len():
        player.QueueAdd(paths.get(i))
        i = i + 1
    end
end

// The command handler: the only place in this file that touches the player.
// The four focus moves never reach it (the keymap preset performs them);
// OpenSearch and OpenCommandLine are ui-internal and are consumed by the loop.
// SearchAccepted reseeds the queue from the rows the new filter keeps, and
// Quit takes the confirmation path `q` and `:q` share.
func onCommand(command: ui.Command):
    if command == ui.Command.Quit:
        ui.RequestQuit()
    else command == ui.Command.PlayPause:
        _ := player.Toggle()
    else command == ui.Command.Next:
        _ := player.Next()
    else command == ui.Command.Prev:
        _ := player.Prev()
    else command == ui.Command.SearchAccepted:
        SyncQueue()
    else command == ui.Command.PlaySelected:
        PlaySelected()
    end
end

// The selected-row play path, shared by Enter on the playlist and `:play` with
// no argument: replaying the playing track toggles, anything else starts it and
// makes its queue position current.
func PlaySelected():
    path := ui.LibrarySelectedPath()
    if path == "":
        ret
    end
    if path == player.CurrentPath() and player.CurrentState() == player.State.Playing:
        _ := player.Toggle()
        ret
    end
    _ := player.Play(path)
    _ := player.QueueSetIndex(ui.LibraryCursor())
end

// Executes one parsed command-line verb. Called from the loop's drain, so player
// state is not shared; every controller rejection becomes the footer error line
// with the controller's own text. `verb.arg` is owned by the caller and freed
// once this returns, so nothing here may keep it.
func runVerb(verb: ui.Verb):
    if verb.name == "play":
        if verb.arg == "":
            PlaySelected()
            ret
        end
        row := ui.LibraryRowByPath(verb.arg)
        if row.path == "":
            ui.SetError("unknown track")
            ret
        end
        if not player.Play(row.path):
            ui.SetError(player.LastErrorText())
            ret
        end
        _ := player.QueueSetIndex(ui.LibraryCursor())
    else verb.name == "pause":
        if not player.Pause():
            ui.SetError(player.LastErrorText())
        end
    else verb.name == "next":
        if not player.Next():
            ui.SetError(player.LastErrorText())
        end
    else verb.name == "prev":
        if not player.Prev():
            ui.SetError(player.LastErrorText())
        end
    else verb.name == "seek":
        if not player.Seek(conv.ParseInt(verb.arg)):
            ui.SetError(player.LastErrorText())
        end
    else verb.name == "volume":
        if not player.SetVolume(conv.ParseInt(verb.arg) as int):
            ui.SetError(player.LastErrorText())
        end
    else verb.name == "search":
        ui.LibraryFilter(verb.arg)
        SyncQueue()
    else verb.name == "help":
        ui.RequestHelp()
    else verb.name == "quit":
        ui.RequestQuit()
    end
end
