import conv
import flag
import os
import term
import time

include "commands/commands.salam"
include "config/config.salam"
include "library/library.salam"
// ui before player: the LLVM backend resolves an enum member written in the
// entry file against the first type of that name in the module, and both
// packages declare a Command. Reordering makes ui.Command unnameable here.
include "ui/ui.salam"
include "player/player.salam"

link static "build/miniaudio.o"
link static "build/ma_shim.o"
link static "build/library_shim.o"

func main:
    f := flag.New("mizrab", commands.Usage())
    defer flag.Free(f)
    flag.AddBool(f, "version", "v", false, "print the version and exit")
    flag.AddBool(f, "scan", "", false, "scan the library roots given as arguments and write the index")
    flag.AddStr(f, "index", "", "", "index file to read and write (default: <data>/mizrab/index.json)")
    flag.AddStr(f, "config", "", "", "config file to read (default: <config>/mizrab/config.ini)")
    if not flag.Parse(f, os.Args()):
        println "mizrab:", flag.Error(f)
        ret 2
    end
    if flag.HelpWanted(f):
        print flag.Usage(f)
        ret 0
    end
    if flag.GetBool(f, "version"):
        println "mizrab " + commands.Version
        ret 0
    end
    // The file is read after --help and --version, so a broken config cannot
    // make either of them fail. A missing default file is not an error; a
    // missing --config is, because the caller named it.
    paths := config.FromEnv()
    mut cfgPath := flag.GetStr(f, "config")
    explicit := flag.WasSet(f, "config")
    if cfgPath == "":
        cfgPath = config.ConfigFile(paths)
    end
    mut file := config.Settings {}
    if cfgPath != "":
        if os.Exists(cfgPath):
            mut e := config.LoadError {}
            file = config.LoadFile(cfgPath, e)
            if e.text != "":
                println "mizrab: " + config.Describe(cfgPath, e)
                ret 2
            end
        else explicit:
            println "mizrab: cannot read " + cfgPath
            ret 2
        end
    end
    if flag.GetBool(f, "scan"):
        // Parse was handed os.Args(), so the program name is positional 0;
        // skip it only when it is there, so a caller passing a bare argument
        // list does not lose the first root.
        args := flag.Positional(f)
        mut cli := config.Settings {}
        mut first := 0
        if args.len() > 0 and args[0] == os.Args()[0]:
            first = 1
        end
        repeat args.len() - first in i:
            cli.roots.push(args[i + first])
        end
        cli.indexPath = flag.GetStr(f, "index")
        // Positional roots sit at the CLI level, so they beat the file's roots,
        // and --index beats the file's library.index.
        st := config.Resolve(config.Defaults(), file, cli)
        if st.roots.len() == 0:
            println "mizrab: --scan needs at least one root"
            ret 2
        end
        mut indexPath := st.indexPath
        if indexPath == "":
            indexPath = config.IndexFile(paths)
            if indexPath == "":
                println "mizrab: cannot find a data directory; pass --index"
                ret 2
            end
        end
        mut count := library.ScanCount {}
        if library.Scan(st.roots, indexPath, count) != 0:
            println "mizrab: scan failed: " + indexPath
            ret 1
        end
        println "mizrab: scanned " + conv.FormatInt(count.total as i64) + " tracks: " + conv.FormatInt(count.added as i64) + " added, " + conv.FormatInt(count.updated as i64) + " updated, " + conv.FormatInt(count.removed as i64) + " removed"
        ret 0
    end
    // A terminal gets the player; anything else gets the usage block, which is
    // what every non-interactive caller (CI, a pipe) has always seen.
    if term.IsTTY(term.StdinFd):
        ret runShell()
    end
    print flag.Usage(f)
    ret 0
end

// The UI path: build the one Shell, run the loop until it stops, and close the
// screen on the way out. The defer lives here rather than in main so the flag
// path and this one do not share a scope.
func runShell(): int:
    player.Init(false)
    mut shell := ui.NewTerminalShell()
    defer shell.Close()
    // start() copies tick_ms into the input thread, so it is set first.
    shell.screen.tick_ms = ui.TickMs
    shell.screen.start()
    ui.Run(shell, (command: ui.Command): onCommand(command) end, (): player.Tick(time.MonoMillis()) end)
    ret 0
end

// The command handler: the only place in this file that touches the player.
// The four focus moves never reach it (the keymap preset performs them);
// OpenSearch and OpenCommandLine are CUR-508 and do nothing yet.
func onCommand(command: ui.Command):
    if command == ui.Command.PlayPause:
        _ := player.Toggle()
    else command == ui.Command.Next:
        _ := player.Next()
    else command == ui.Command.Prev:
        _ := player.Prev()
    end
end
