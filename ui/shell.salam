// The app shell: one basalam Screen whose root is a Column of a header Row, a
// body Column of two framed panels and a footer Row. The four focus stops are
// the playlist panel and the three footer segments, in the order the widgets
// are added: basalam walks the registry by ascending id, so insertion order is
// the focus ring and there is no separate focus list. Every container child is
// also registered on the screen with the same value, or it would be positioned
// and never painted.
//
// Geometry (STAGE-02): header h 1, pad-x 2, gap 2, wordmark 15 + context fill;
// body fill, a Column of playlist Fill and now playing Fixed 5 (body shorter
// than 14 rows) or Fixed 6; footer h 1, pad-x 1, status 11 or 3 + keys fill +
// mode 9. The footer ladder and the `< 40 × 12` degrade line are refit rules,
// not content: both are derived from the width when the shell resizes.
//
// basalam boxes a container as a `dyn Widget`, and a box cannot be downcast,
// so Resize places the footer slots and the two body panels itself instead of
// mutating the Row/Column slot sizes. A container still lays its children out
// first; those rects are overwritten in the same call, before any paint.

package ui

import str
import term
import "github.com/curedbylethe/basalam/basalam"

const _WORDMARK := "[ M I Z R A B ]"

const _CONTEXT := "‹context›"

const _STATUS_HEAD := "▶︎"

const _STATUS := "playing"

const _MODE := "normal"

// Hint labels, full then short, then the short set with whole hints dropped in
// the order p, /, n, : — space and q are never dropped. Each drop costs two
// more cells for the trailing ` …` marker.
const _HINTS_FULL := "space play/pause  n next  p previous  : command  / search  q quit"

const _HINTS_SHORT := "space play  n next  p prev  : cmd  / search  q quit"

const _HINTS_NO_P := "space play  n next  : cmd  / search  q quit"

const _HINTS_NO_P_SLASH := "space play  n next  : cmd  q quit"

const _HINTS_NO_P_SLASH_N := "space play  : cmd  q quit"

const _HINTS_MIN := "space play  q quit"

const _DEGRADE := "too small · 40 × 12"

const _MIN_WIDTH := 40

const _MIN_HEIGHT := 12

// The mode slot and the right pad: the footer reserves W - 10 for the mode.
const _MODE_WIDTH := 9

// The widget registry, in Screen.add order. focus_order() sorts by id, so the
// ascending ids are the focus ring: playlist, status, keys, mode.
@en "RootId"
/// The screen's root widget id; basalam assigns it.
pub const RootId := 0

@en "HeaderId"
/// The header Row.
pub const HeaderId := 1

@en "WordmarkId"
/// The `[ M I Z R A B ]` segment.
pub const WordmarkId := 2

@en "ContextId"
/// The right-aligned context segment.
pub const ContextId := 3

@en "BodyId"
/// The body Column holding the two panels.
pub const BodyId := 4

@en "PlaylistId"
/// The playlist panel: the first focus stop.
pub const PlaylistId := 5

@en "NowPlayingId"
/// The now-playing panel; never a focus stop.
pub const NowPlayingId := 6

@en "FooterId"
/// The footer Row.
pub const FooterId := 7

@en "StatusId"
/// The playback status segment.
pub const StatusId := 8

@en "KeysId"
/// The hint segment; the prompt owner from stage 05.
pub const KeysId := 9

@en "ModeId"
/// The mode segment.
pub const ModeId := 10

@en "DegradeId"
/// The `too small` cover.
pub const DegradeId := 11

// Which line a Segment draws.
enum Slot:
    Wordmark
    Context
    Status
    Hints
    Mode
end

// One line of text in the shell. The focused segment draws its label run —
// the text plus one cell each side — inverse yellow (STAGE-02); the label
// itself is derived per render, so a resize needs no widget mutation.
struct Segment:
    pub use basalam.BaseWidget

    slot: Slot = Slot.Wordmark
    align: basalam.Alignment = basalam.Alignment.Left
    style: basalam.Style = basalam.StyleDefault
    head: str = ""
    head_style: basalam.Style = basalam.StyleDefault
    inset: int = 0
    focus: bool = false

    pub func focusable(): bool:
        ret this.focus
    end

    pub func render(buf: basalam.Buffer, bounds: basalam.Rect):
        tier := basalam.DetectTier()
        mut label := ""
        if this.slot == Slot.Wordmark:
            label = _WORDMARK
        else this.slot == Slot.Context:
            label = TruncatePath(_CONTEXT, bounds.width - 2 * this.inset)
        else this.slot == Slot.Status:
            // The 3-cell status slot holds the glyph alone; 11 holds the word.
            if bounds.width >= 11:
                label = _STATUS
            end
        else this.slot == Slot.Hints:
            label = _fitHints(bounds.width - 2 * this.inset)
        else:
            label = _MODE
        end
        mut run := label
        if this.head != "":
            run = label == "" ? this.head : this.head + " " + label
        end
        mut x := bounds.x + this.inset
        if this.align == basalam.Alignment.Right:
            x = bounds.x + bounds.width - this.inset - term.Width(run)
        end
        if buf.focused:
            buf.put_str(x - 1, bounds.y, " " + run + " ", _focus_sgr())
            ret
        end
        mut cx := x
        if this.head != "":
            buf.put_str(cx, bounds.y, this.head, basalam.StyleSgr(this.head_style, tier))
            cx = cx + term.Width(this.head) + 1
        end
        buf.put_str(cx, bounds.y, label, basalam.StyleSgr(this.style, tier))
    end
end

// The panel: a light single-line frame, heavy and yellow while focused. The
// title rides the top edge from x + 2 as one run.
struct Frame:
    pub use basalam.BaseWidget

    title: str = ""
    focus: bool = true

    pub func focusable(): bool:
        ret this.focus
    end

    pub func render(buf: basalam.Buffer, bounds: basalam.Rect):
        tier := basalam.DetectTier()
        mut edge := basalam.Style { fg = basalam.BrightBlack }
        if buf.focused:
            edge = basalam.Style { fg = basalam.Yellow }
            _draw_heavy(buf, bounds, edge)
        else:
            basalam.DrawBorder(buf, bounds, basalam.BorderStyle.Single, edge, "")
        end
        if bounds.width < 6:
            ret
        end
        run := " " + this.title + " "
        mut sgr := basalam.StyleSgr(edge, tier)
        if buf.focused:
            sgr = sgr + term.Sgr(term.StyleReverse)
        end
        buf.put_str(bounds.x + 2, bounds.y, run, sgr)
    end
end

// The degrade cover: at less than 40 × 12 it clears every cell and writes one
// centred line in bright black, so the Column underneath is not drawn.
struct Degrade:
    pub use basalam.BaseWidget

    pub func render(buf: basalam.Buffer, bounds: basalam.Rect):
        if bounds.width >= _MIN_WIDTH and bounds.height >= _MIN_HEIGHT:
            ret
        end
        buf.fill(bounds, " ", "")
        w := term.Width(_DEGRADE)
        mut x := bounds.x + (bounds.width - w) / 2
        if x < bounds.x:
            x = bounds.x
        end
        buf.put_str(
            x, bounds.y + bounds.height / 2, _DEGRADE, basalam.StyleSgr(basalam.Style { fg = basalam.BrightBlack }, basalam.DetectTier())
        )
    end
end

@en "Shell"
/// The app shell: the screen and its root tree. Build it with NewShell or
/// NewTerminalShell.
pub struct Shell:
    @en "screen"
    /// The one Screen the shell owns. Never copy it: it holds the buffer, the
    /// widget tree, the event channel and the thread handles.
    pub screen: basalam.Screen

    width: int = 0
    height: int = 0

    @en "Resize"
    /// Refits the root tree to `width` × `height`: the footer ladder picks the
    /// status width, the gap and the keys width, and the body split picks the
    /// now-playing height. The degrade cover keeps the size of the screen.
    pub func Resize(width: int, height: int):
        row := _footerCase(width)
        mut status := 11
        if row == 2:
            status = 3
        end
        mut gap := 1
        if row > 0:
            gap = 0
        end
        keys_x := 1 + status + gap
        this.screen.resize(width, height)
        y := height - 1
        this.screen.widget(StatusId).set_bounds(
            basalam.Rect { x = 1, y = y, width = status, height = 1 }
        )
        this.screen.widget(KeysId).set_bounds(
            basalam.Rect { x = keys_x, y = y, width = width - 10 - gap - keys_x, height = 1 }
        )
        this.screen.widget(ModeId).set_bounds(
            basalam.Rect { x = width - 10, y = y, width = _MODE_WIDTH, height = 1 }
        )
        body := height - 2
        mut now := 5
        if body >= 14:
            now = 6
        end
        this.screen.widget(PlaylistId).set_bounds(
            basalam.Rect { x = 0, y = 1, width = width, height = body - now }
        )
        this.screen.widget(NowPlayingId).set_bounds(
            basalam.Rect { x = 0, y = 1 + body - now, width = width, height = now }
        )
        this.width = width
        this.height = height
        this.screen.widget(DegradeId).set_bounds(basalam.Rect { width = width, height = height })
    end

    @en "FocusOrder"
    /// The focus stop ids in ring order: playlist, status, keys, mode. The
    /// caller frees the vector.
    pub func FocusOrder(): Vector<int>:
        mut ids := Vector {} as Vector<int>
        ids.push(PlaylistId)
        ids.push(StatusId)
        ids.push(KeysId)
        ids.push(ModeId)
        ret ids
    end

    @en "Hints"
    /// The footer hint line at a screen width of `width` columns: the full
    /// labels, the short labels, then whole hints dropped lowest-first.
    pub func Hints(width: int): str:
        row := _footerCase(width)
        mut status := 11
        if row == 2:
            status = 3
        end
        mut gap := 1
        if row > 0:
            gap = 0
        end
        ret _fitHints(width - 10 - gap - (1 + status + gap) - 2)
    end

    @en "Degraded"
    /// True below 40 columns or 12 rows, where the tree is replaced by the
    /// `too small` line.
    pub func Degraded(): bool:
        ret this.width < _MIN_WIDTH or this.height < _MIN_HEIGHT
    end

    @en "Close"
    /// Releases the screen; meant for `defer` and safe to call twice.
    pub func Close():
        this.screen.close()
    end
end

// The focused label run: yellow plus reverse video. term.Sgr builds the
// reverse attribute because basalam.Style has no reverse field.
func _focus_sgr(): str:
    ret basalam.StyleSgr(basalam.Style { fg = basalam.Yellow }, basalam.DetectTier()) + term.Sgr(term.StyleReverse)
end

// The heavy ring basalam has no BorderStyle for: a focused panel draws
// ┏ ━ ┓ ┃ ┗ ┛ (STAGE-02 artifact), not the ╔ ═ ╗ that Double uses.
func _draw_heavy(buf: basalam.Buffer, bounds: basalam.Rect, style: basalam.Style):
    if bounds.width <= 1 or bounds.height <= 1:
        ret
    end
    sgr := basalam.StyleSgr(style, basalam.DetectTier())
    w := bounds.width - 1
    h := bounds.height - 1
    bar := str.Repeat("━", w - 1)
    buf.put_str(bounds.x, bounds.y, "┏" + bar + "┓", sgr)
    mut y := 1
    until y < h:
        buf.put_str(bounds.x, bounds.y + y, "┃", sgr)
        buf.put_str(bounds.x + w, bounds.y + y, "┃", sgr)
        y = y + 1
    end
    buf.put_str(bounds.x, bounds.y + h, "┗" + bar + "┛", sgr)
end

// The hint line for `max` cells: full labels, then short labels, then the
// short set with p, /, n, : dropped in that order, each drop marked by ` …`.
// When even the shortest does not fit, the shortest is returned unchanged:
// the caller sees the overflow and a silent clip never reaches the screen.
func _fitHints(max: int): str:
    if CellWidth(_HINTS_FULL) <= max:
        ret _HINTS_FULL
    end
    if CellWidth(_HINTS_SHORT) <= max:
        ret _HINTS_SHORT
    end
    if CellWidth(_HINTS_NO_P) + 2 <= max:
        ret _HINTS_NO_P + " …"
    end
    if CellWidth(_HINTS_NO_P_SLASH) + 2 <= max:
        ret _HINTS_NO_P_SLASH + " …"
    end
    if CellWidth(_HINTS_NO_P_SLASH_N) + 2 <= max:
        ret _HINTS_NO_P_SLASH_N + " …"
    end
    ret _HINTS_MIN + " …"
end

// The footer ladder: (gap 1, status word), (gap 0, status word), (gap 0,
// glyph). The first row whose keys slot fits a hint line wins; the third is
// the shortest legal layout at the 40 × 12 floor.
func _footerCase(width: int): int:
    repeat 3 in i:
        mut status := 11
        if i == 2:
            status = 3
        end
        mut gap := 1
        if i > 0:
            gap = 0
        end
        keys_w := width - 10 - gap - (1 + status + gap)
        if CellWidth(_fitHints(keys_w - 2)) <= keys_w - 2:
            ret i
        end
    end
    ret 2
end

@en "NewShell"
/// Builds the headless shell: one Screen over the header/body/footer tree, the
/// four focus stops in ring order, and no terminal. Nothing touches the
/// terminal, so this is what tests use.
pub func NewShell(width: int, height: int): Shell:
    // Each widget is boxed exactly once, as a `dyn Widget`, and that one value
    // goes to both the container and the screen registry. Boxing a plain
    // struct at each call would make two widgets: one laid out, one painted.
    mut header := basalam.NewRow()
    header.set_padding(basalam.NewInsets(0, 2, 0, 2))
    header.set_gap(2)
    mut body := basalam.NewColumn()
    mut footer := basalam.NewRow()
    footer.set_padding(basalam.NewInsets(0, 1, 0, 1))
    mut root := basalam.NewColumn()

    wordmark := Segment { slot = Slot.Wordmark, style = basalam.Style { fg = basalam.BrightWhite, bold = true } } as dyn basalam.Widget
    context := Segment { slot = Slot.Context, align = basalam.Alignment.Right } as dyn basalam.Widget
    playlist := Playlist { title = "playlist" } as dyn basalam.Widget
    nowplaying := Frame { title = "now playing", focus = false } as dyn basalam.Widget
    status := Segment {
        slot = Slot.Status, head = _STATUS_HEAD, head_style = basalam.Style { fg = basalam.Green },
        inset = 1, focus = true,
    } as dyn basalam.Widget
    keys := Segment { slot = Slot.Hints, style = basalam.Style { fg = basalam.BrightBlack }, inset = 1, focus = true } as dyn basalam.Widget
    mode := Segment { slot = Slot.Mode, align = basalam.Alignment.Right, inset = 1, focus = true } as dyn basalam.Widget
    degrade := Degrade {} as dyn basalam.Widget

    _ := header.add(wordmark)
    _ := header.add(context)
    header.set_width(0, basalam.LayoutSize { kind = basalam.SizeKind.Fixed, cells = 15 })
    _ := body.add(playlist)
    _ := body.add(nowplaying)
    body.set_height(1, basalam.LayoutSize { kind = basalam.SizeKind.Fixed, cells = 5 })
    _ := footer.add(status)
    _ := footer.add(keys)
    _ := footer.add(mode)
    footer.set_width(0, basalam.LayoutSize { kind = basalam.SizeKind.Fixed, cells = 11 })
    footer.set_width(1, basalam.LayoutSize { kind = basalam.SizeKind.Fixed, cells = 16 })
    footer.set_width(2, basalam.LayoutSize { kind = basalam.SizeKind.Fixed, cells = _MODE_WIDTH })

    header_box := header as dyn basalam.Widget
    body_box := body as dyn basalam.Widget
    footer_box := footer as dyn basalam.Widget
    _ := root.add(header_box)
    _ := root.add(body_box)
    _ := root.add(footer_box)
    root.set_height(0, basalam.LayoutSize { kind = basalam.SizeKind.Fixed, cells = 1 })
    root.set_height(2, basalam.LayoutSize { kind = basalam.SizeKind.Fixed, cells = 1 })

    mut screen := basalam.NewScreen(root as dyn basalam.Widget, width, height)
    _ := screen.add(RootId, header_box)
    _ := screen.add(HeaderId, wordmark)
    _ := screen.add(HeaderId, context)
    _ := screen.add(RootId, body_box)
    _ := screen.add(BodyId, playlist)
    _ := screen.add(BodyId, nowplaying)
    _ := screen.add(RootId, footer_box)
    _ := screen.add(FooterId, status)
    _ := screen.add(FooterId, keys)
    _ := screen.add(FooterId, mode)
    _ := screen.add(RootId, degrade)

    mut sh := Shell { screen = screen, width = width, height = height }
    // The same path a resize takes, so construction and resize agree.
    sh.Resize(width, height)
    ret sh
end

@en "NewTerminalShell"
/// Builds the shell at the current terminal's size. Uses NewShell, so the tree
/// is the same tree the tests exercise.
pub func NewTerminalShell(): Shell:
    size := term.Size()
    ret NewShell(size.cols, size.rows)
end

@en "Open"
/// Takes over the terminal: raw mode, alternate screen, hidden cursor. The only
/// caller of Screen.start(), paired with Shell.Close. TickMs is set before it,
/// because start() copies it into the input thread. A stdin that is not a
/// terminal has nothing to attach to, so this is a no-op there; main refuses
/// that case already, and it is what keeps a headless test headless.
pub func Open(sh &: Shell):
    if not IsTTY():
        ret
    end
    sh.screen.start()
end
