// The one event loop: read an event, let the screen dispatch it, apply the
// commands the keymap reported, then paint. Ticks are basalam's own: start()
// copies tick_ms into the input thread, which posts a TickEvent from its poll
// timeout, so this loop spawns no timer of its own. The command sink runs
// inside dispatch, on this thread, so the pending list needs no lock.
//
// Nothing here names the player: the loop reports verbs to onCommand and reads
// the clock through onTick, so main supplies both and this file stays the only
// place that knows the frame order.

package ui

import "github.com/curedbylethe/basalam/basalam"

@en "TickMs"
/// The tick interval in milliseconds: it refreshes the position display at
/// 10 Hz and is not an audio parameter. Set it before Screen.start().
pub const TickMs := 100

// Verbs the keymap reported and the loop has not applied yet. A lambda
// captures by value, so the sink cannot own a local vector; one loop runs at a
// time, which is what makes a package-level list safe.
mut pending := Vector {} as Vector<Command>

// Parsed command-line verbs waiting for the app's sink. Same lifetime rule as
// `pending`; the prompt pushes here and `_drain` runs each one after the
// command list, so `:search` sees its own SearchAccepted first.
mut pendingVerbs := Vector {} as Vector<Verb>

// The app's verb sink, installed before Run. A Verb carries no player type, so
// the interface layer can hand one over without naming the player.
mut _verbSink := (verb: Verb):
    _ := verb
end

// Which map is installed: false = the normal one, true = the modal one. One
// loop runs at a time and set_keymap owns the map, so a flag is enough to keep
// the swap idempotent.
mut _modalMap := false

// The map the loop installs: Vim plus nothing. `q` lives in Vim now, because
// its action needs the screen and the pushed playback word (stage 07), and this
// file only keeps the sink the verbs go into. Esc stays unbound here: the
// preset uses it to close a modal.
func _keymap(): basalam.Keymap:
    ret Vim((command: Command): pending.push(command) end)
end

// Applies the verbs in the order the keys arrived, then empties the list. The
// two prompts are ui-internal: they open a mode here and never reach the app.
func _drain(onCommand: func (Command)):
    mut i := 0
    until i < pending.len():
        command := pending.get(i)
        if command == Command.OpenSearch:
            OpenSearch()
        else command == Command.OpenCommandLine:
            OpenCommandLine()
        else:
            onCommand(command)
        end
        i = i + 1
    end
    pending.clear()
    // The parsed commands come after the keymap's verbs. Parse owns the
    // argument, so it is freed once the sink has returned.
    mut j := 0
    until j < pendingVerbs.len():
        verb := pendingVerbs.get(j)
        _verbSink(verb)
        _freeStr(verb.arg)
        j = j + 1
    end
    pendingVerbs.clear()
end

@en "SyncKeymap"
/// Installs the map the overlay state calls for: ModalKeymap while a panel is
/// up, a fresh normal map once none is. Run calls this once per frame, after
/// ApplyOverlay and the close drain, so a key that opens or closes a panel
/// swaps at the frame boundary, never mid-key. set_keymap frees the map it
/// replaces, which is why the normal map is rebuilt rather than kept. Idempotent:
/// when the state already matches, no map is touched.
pub func SyncKeymap(screen &: basalam.Screen):
    want := OverlayOpen()
    if want == _modalMap:
        ret
    end
    _modalMap = want
    if want:
        screen.set_keymap(ModalKeymap())
    else:
        screen.set_keymap(_keymap())
    end
end

@en "SetVerbSink"
/// Installs the function `_drain` calls for each parsed command-line verb, on
/// the loop thread, after every command the keymap reported. `ui.Run` does not
/// take it, so its signature stays stable; main installs it once before Run.
pub func SetVerbSink(f: func (Verb)):
    _verbSink = f
end

@en "Run"
/// Runs the shell's event loop until `q` or an unconsumed Ctrl-C stops the
/// screen. `flagPath` is the crash flag, or "" when no state directory was
/// resolved: Begin repairs a terminal a previous run left dirty and installs
/// the signal guard before the screen is opened, and End and Close are deferred
/// around the loop so the order on the way out is close-then-clear. Installs
/// the keymap (the screen then owns it) and arms ticks. `onCommand` runs
/// on this thread between frames, after the event is dispatched and before the
/// next paint, so a key takes effect in the frame it was read. `onTick` runs
/// once per tick, before the tick is dispatched. A resize reaches the shell
/// before dispatch, which resizes the screen alone: the shell owns the degrade
/// cover's bounds and the size Degraded() reports.
pub func Run(flagPath: str, sh &: Shell, onCommand: func (Command), onTick: func ()):
    sh.screen.tick_ms = TickMs
    sh.screen.set_keymap(_keymap())
    _modalMap = false
    Begin(flagPath)
    defer End(flagPath)
    Open(sh)
    defer sh.Close()
    sh.screen.present()
    mut ev := basalam.Event {}
    until sh.screen.next_event(ev):
        if ev.kind == basalam.TickEvent:
            onTick()
            sh.screen.dirty = true
        end
        wasCommand := CurrentMode() == Mode.Command
        consumed := sh.screen.dispatch(ev)
        // A normal-mode key dismisses the command error line. Before _drain,
        // so the verb that same key submits can set the next one.
        if consumed and CurrentMode() == Mode.Normal:
            ClearError()
        end
        // Esc inside a modal closes it inside dispatch; the loop mirrors the
        // app half of the protocol: unraise the subtree, then drop the focus
        // push. unraise already marks the next frame full, which is the clean
        // frame the dim needs on the way out.
        closed := TakeClosedOverlay()
        if closed != basalam.NoWidget:
            sh.screen.unraise_subtree(closed)
            _ := sh.screen.pop_focus()
        end
        // The completion popup paints outside the prompt's one-row bounds, so
        // command mode needs a whole frame to clear it again.
        if ev.kind == basalam.KeyEvent and (wasCommand or CurrentMode() == Mode.Command):
            sh.screen.dirty = true
        end
        // A key that changed a view mutates package state, not the screen, so
        // the loop requests the repaint the widget could not.
        if ViewChanged():
            sh.screen.dirty = true
            ClearViewChanged()
        end
        if ev.kind == basalam.ResizeEvent:
            // After dispatch, not before: dispatch resizes the screen and lays
            // the root out again, which would overwrite the cover's bounds.
            sh.Resize(ev.width, ev.height)
            OverlayResize(sh.screen)
        end
        _drain(onCommand)
        // The prompt asked for a focus move while it handled the key; a widget
        // cannot reach the screen, so it happens here, before the paint.
        ApplyFocus(sh.screen)
        // The command sink only ever holds a copy of the shell, so `:help` and
        // `:q` queue their request and the loop applies it on this screen.
        ApplyOverlay(sh.screen)
        // Both ways an overlay can open or close have now run: the close drain
        // above and the request ApplyOverlay just applied. Swapping only here
        // means one swap per frame at most, and none when nothing changed.
        SyncKeymap(sh.screen)
        // An open overlay paints a dim and a ring outside its own dispatch
        // region, so its frame is full every time; closing it already marked a
        // full repaint above.
        if OverlayOpen():
            sh.screen.dirty = true
        end
        // basalam's own rule, restated because this loop owns the iteration.
        if not consumed and ev.is_ctrl("c"):
            sh.screen.stop()
        end
        // present() returns at once when nothing changed, which is the same
        // guard basalam's loop spells with its private region list.
        sh.screen.present()
    end
end
