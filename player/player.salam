// The playback controller: a headless player over the audio engine. Package
// player is every player/*.salam file merged; this file is the entry point and
// owns the scalar state. The engine is a singleton (one file, one device), so
// the controller is one too and its state lives in package globals.
//
//   state.salam   the states, the commands and the transition table
//   errors.salam  the error codes, their text and the last-error record
//   controller.salam  the commands, position and duration over the engine
//
// Imports nothing above the engine: no basalam, no terminal, no library.

package player

mut playerState := State.Idle
mut playerError := ErrorCode.None
mut playerDetail := ""
mut playerNullBackend := false
mut playerVolume := 100

@en "Init"
/// Starts a fresh player. `nullBackend` selects miniaudio's null device, which
/// tests use so no audio hardware is needed; the app passes false. Sets the
/// state to idle, clears the last error and sets the volume to 100.
pub func Init(nullBackend: bool):
    playerNullBackend = nullBackend
    playerVolume = 100
    Reset()
end

@en "Reset"
/// Closes the engine, returns the player to idle and clears the last error.
/// Leaves the volume and the backend mode alone. Tests call it between cases.
pub func Reset():
    audio.Close()
    playerCurrent = ""
    playerState = State.Idle
    clearError()
end

@en "CurrentState"
/// The current playback state.
pub func CurrentState(): State:
    ret playerState
end
