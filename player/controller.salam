// The controller's commands: each one consults the transition table first and
// only then touches the engine, so a rejected command changes nothing but the
// last error. Position and duration come from the engine's frame counters; the
// package reads no clock, and time arrives through Tick.
//
// The engine is a singleton, so a failed Play leaves no file open: every
// failure path ends in audio.Close.

package player

import fs.file
import os

include "../audio/audio.salam"

// Everything the engine hands over is 48000 Hz (see audio.salam), so a frame
// count converts to milliseconds with this one rate.
const playerRate := 48000 as i64

mut playerCurrent := ""
mut playerDecodeBase := 0 as i64
mut playerGapStart := -1 as i64
mut playerLastGap := -1 as i64
mut playerGapPending := false
mut playerPlayedBase := 0 as i64

// Rejects `command` in the current state: records why and reports false.
func reject(): bool:
    setError(ErrorCode.BadArgument, "command not allowed in state " + StateName(playerState))
    ret false
end

// Closes the engine and parks the player in `error`; the caller has already
// recorded the code. Always returns false so a command can `ret fail()`.
func fail(): bool:
    audio.Close()
    playerCurrent = ""
    playerState = State.Error
    ret false
end

// Reports whether `path` has an extension the decoder handles.
func knownExtension(path: str): bool:
    ext := file.Extension(path).lower()
    ret ext == ".wav" or ext == ".flac" or ext == ".mp3" or ext == ".ogg"
end

// Opens `path` in the engine, or records why not: FileMissing, PermissionDenied,
// UnsupportedCodec or DecodeFailure. Checks run in that order; the engine is
// only asked once the file is known to exist, be a file and be readable.
func openFile(path: str): bool:
    if path == "":
        setError(ErrorCode.BadArgument, "empty path")
        ret false
    end
    if os.Exists(path) == false:
        setError(ErrorCode.FileMissing, path)
        ret false
    end
    if os.IsDir(path):
        setError(ErrorCode.FileMissing, "not a file")
        ret false
    end
    if file.Stat(path).permissions == 0:
        setError(ErrorCode.PermissionDenied, path)
        ret false
    end
    if audio.Open(path):
        ret true
    end
    if knownExtension(path) == false:
        setError(ErrorCode.UnsupportedCodec, path)
    else:
        setError(ErrorCode.DecodeFailure, audio.DecoderLastError())
    end
    ret false
end

// Starts the device. A failed start is DeviceLost with the device's own words.
func startDevice(): bool:
    if audio.Start(playerNullBackend):
        ret true
    end
    setError(ErrorCode.DeviceLost, audio.DevLastError())
    ret false
end

// Opens and starts `path`, replacing whatever was playing: the body of Play and
// of every move through the queue. The caller has checked the table. A start
// is never a gap in progress, so any pending gap is dropped. On failure the
// state is error and no file stays open.
func startPath(path: str): bool:
    playerGapPending = false
    playerState = State.Loading
    audio.Close()
    playerCurrent = ""
    clearError()
    if openFile(path) == false:
        ret fail()
    end
    if startDevice() == false:
        ret fail()
    end
    playerCurrent = path
    playerDecodeBase = audio.ReadStatus().decodeErrors
    audio.SetVolume(playerVolume)
    playerState = State.Playing
    ret true
end

// The queue move behind Next and Prev: the table first, then the queue, then
// the same open-and-start as Play. The index moves before the open, so a track
// that fails to open is skipped by the next move.
func step(command: Command, forward: bool): bool:
    if NextState(playerState, command).allowed == false:
        ret reject()
    end
    if QueueLen() == 0:
        setError(ErrorCode.BadArgument, "queue is empty")
        ret false
    end
    i := queueAdvance(forward)
    if i < 0:
        if forward:
            setError(ErrorCode.BadArgument, "end of queue")
        else:
            setError(ErrorCode.BadArgument, "start of queue")
        end
        ret false
    end
    ret startPath(queuePaths.get(i))
end

// The track drained. Decides what plays next: nothing when there is no queue or
// it has run out, the same track for repeat One, otherwise the next entry. A
// started track opens the gap, which Tick closes at its first played frame.
func advanceAfterEnd(nowMs: i64):
    mut path := playerCurrent
    if QueueLen() == 0:
        playerState = State.Ended
        audio.Stop()
        ret
    end
    if queueRepeat != RepeatMode.One:
        i := queueAdvance(true)
        if i < 0:
            playerState = State.Ended
            audio.Stop()
            ret
        end
        path = queuePaths.get(i)
    end
    if startPath(path) == false:
        ret
    end
    playerGapStart = nowMs
    playerGapPending = true
    playerPlayedBase = audio.ReadStatus().framesPlayed
end

func pauseNow():
    playerGapPending = false
    playerState = State.Paused
    audio.Stop()
end

func resumeNow(): bool:
    if startDevice() == false:
        ret fail()
    end
    playerState = State.Playing
    ret true
end

@en "Play"
/// Opens and starts `path`, replacing whatever was playing. A path that is in
/// the queue becomes the current entry, so Next follows from it; any other path
/// leaves the queue alone. On failure the state is error, the last error says
/// why and no file stays open.
pub func Play(path: str): bool:
    if NextState(playerState, Command.Play).allowed == false:
        ret reject()
    end
    queueFollow(path)
    ret startPath(path)
end

@en "Pause"
/// Pauses playback. The file stays open and no audio is lost.
pub func Pause(): bool:
    if NextState(playerState, Command.Pause).allowed == false:
        ret reject()
    end
    pauseNow()
    ret true
end

@en "Resume"
/// Resumes a paused track where it stopped.
pub func Resume(): bool:
    if NextState(playerState, Command.Resume).allowed == false:
        ret reject()
    end
    ret resumeNow()
end

@en "Toggle"
/// Pauses a playing track, resumes a paused one and replays an ended one.
pub func Toggle(): bool:
    if NextState(playerState, Command.Toggle).allowed == false:
        ret reject()
    end
    if playerState == State.Playing:
        pauseNow()
        ret true
    end
    if playerState == State.Paused:
        ret resumeNow()
    end
    ret Play(playerCurrent)
end

@en "Stop"
/// Stops playback and releases the file. Position and duration become -1.
pub func Stop(): bool:
    if NextState(playerState, Command.Stop).allowed == false:
        ret reject()
    end
    audio.Stop()
    audio.Close()
    playerCurrent = ""
    clearError()
    playerState = State.Stopped
    ret true
end

@en "Next"
/// Plays the next queue entry (the next one in the shuffle deck when shuffle
/// is on). False when the queue is empty or, with repeat Off, already at its
/// end. Repeat One does not change an explicit next.
pub func Next(): bool:
    ret step(Command.Next, true)
end

@en "Prev"
/// Plays the previous queue entry. Always linear, even with shuffle on. False
/// when the queue is empty or, with repeat Off, already at its start.
pub func Prev(): bool:
    ret step(Command.Prev, false)
end

@en "Seek"
/// Moves playback to `seconds` from the start. Only while playing. A target
/// past a known length is clamped to the last frame. The engine finishes the
/// seek asynchronously, so PositionMs settles a moment later.
pub func Seek(seconds: i64): bool:
    if NextState(playerState, Command.Seek).allowed == false:
        ret reject()
    end
    if seconds < 0:
        setError(ErrorCode.BadArgument, "negative seek")
        ret false
    end
    mut frames := seconds * playerRate
    s := audio.ReadStatus()
    if s.lengthKnown and frames >= s.lengthFrames:
        frames = s.lengthFrames - 1
    end
    if audio.Seek(frames) == false:
        setError(ErrorCode.DecodeFailure, "seek rejected")
        ret false
    end
    ret true
end

@en "SetVolume"
/// Sets the volume, 0 to 100. Stored when no device exists yet and applied at
/// the next Play.
pub func SetVolume(percent: int): bool:
    if NextState(playerState, Command.Volume).allowed == false:
        ret reject()
    end
    if percent < 0 or percent > 100:
        setError(ErrorCode.BadArgument, "volume must be 0 to 100")
        ret false
    end
    playerVolume = percent
    if audio.GetVolume() >= 0:
        audio.SetVolume(percent)
    end
    ret true
end

@en "GetVolume"
/// The requested volume, 0 to 100, whether or not a device exists.
pub func GetVolume(): int:
    ret playerVolume
end

@en "Tick"
/// Call this regularly from the event loop. While playing it notices a decode
/// error and the end of the track, which advances the queue (see the repeat
/// modes) or ends playback. `nowMs` is a monotonic clock reading the caller
/// supplies; it only times the gap between tracks.
pub func Tick(nowMs: i64):
    if playerState != State.Playing:
        ret
    end
    s := audio.ReadStatus()
    if playerGapPending and s.framesPlayed > playerPlayedBase:
        playerLastGap = nowMs - playerGapStart
        if playerLastGap < 0:
            playerLastGap = 0
        end
        playerGapPending = false
    end
    if s.decodeErrors > playerDecodeBase:
        setError(ErrorCode.DecodeFailure, audio.DecoderLastError())
        audio.Stop()
        fail()
        ret
    end
    if s.atEnd and s.fillLevel == 0:
        advanceAfterEnd(nowMs)
    end
end

@en "LastGapMs"
/// The last measured gap between two tracks, in milliseconds, or -1 until one
/// has been. It runs from the Tick that saw a track drain to the Tick that saw
/// the next one play its first frame, so it is the controller's own restart
/// cost (close, open, start and the device's first callback), not silence put
/// in on purpose. Only an automatic advance is measured, not a Next or Prev.
pub func LastGapMs(): i64:
    ret playerLastGap
end

@en "CurrentPath"
/// The path being played, or the empty string when no file is open.
pub func CurrentPath(): str:
    ret playerCurrent
end

@en "DurationMs"
/// The track length in milliseconds, or -1 when no file is open or the format
/// has no known length (Ogg Vorbis).
pub func DurationMs(): i64:
    s := audio.ReadStatus()
    if s.fillCapacity == 0 or s.lengthKnown == false:
        ret -1
    end
    ret s.lengthFrames * 1000 / playerRate
end

@en "PositionMs"
/// How far playback has got, in milliseconds, from decoded frames: the decoder's
/// stream position minus the frames still queued for the device. -1 when no
/// file is open.
pub func PositionMs(): i64:
    s := audio.ReadStatus()
    if s.fillCapacity == 0:
        ret -1
    end
    mut frames := audio.DecoderFramesDecoded() - s.fillLevel
    if frames < 0:
        frames = 0
    end
    mut ms := frames * 1000 / playerRate
    d := DurationMs()
    if d >= 0 and ms > d:
        ms = d
    end
    ret ms
end
